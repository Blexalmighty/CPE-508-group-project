# Copy to .env (same folder) and fill in real values. .env is gitignored.
#
# The login credential accepted by /api/login:
STAFF_ID=staff
STAFF_PASSWORD=change-me-use-a-real-password

# At least 16 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SECRET=

# Production frontend origin(s), comma-separated. If you host the static
# frontend on Vercel at https://oncopredict.vercel.app, put that here.
# Only the dev server origins are allowed when this is unset.
# ALLOWED_ORIGINS=https://oncopredict.vercel.app
